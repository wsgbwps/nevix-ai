# Non-secret Supabase Auth policy shared by self-hosted deployments and the
# pinned policy harness. Runtime URLs, database credentials, signing keys,
# SMTP credentials, and provider secrets belong to each environment.
GOTRUE_JWT_EXP=3600
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10
GOTRUE_PASSWORD_MIN_LENGTH=12
GOTRUE_PASSWORD_REQUIRED_CHARACTERS=
GOTRUE_PASSWORD_HIBP_ENABLED=true
GOTRUE_PASSWORD_HIBP_FAIL_CLOSED=false
GOTRUE_SESSIONS_INACTIVITY_TIMEOUT=336h
GOTRUE_SESSIONS_TIMEBOX=2160h
