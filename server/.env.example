# Local development only. Copy this file to .env.local before starting Server
# (make server loads it). The server needs two credentials:
#   - MIGRATION_DATABASE_URL: DDL credential (owner); applies up-only schema
#     migrations at startup and is then closed.
#   - DATABASE_URL: the application credential; must authenticate directly as
#     the identity_app LOGIN role.
# With `make postgres` (the local dev stack), both passwords default to `dev`:
# it initializes the postgres superuser with `dev` and idempotently provisions
# the identity_app role with `dev`. The migrations adopt an existing role and
# never reset its password — on a stack whose credentials you changed, keep
# .env.local in sync with the database instead of editing only one side.
DATABASE_URL='postgresql://identity_app:dev@127.0.0.1:5432/postgres?sslmode=disable'
MIGRATION_DATABASE_URL='postgresql://postgres:dev@127.0.0.1:5432/postgres?sslmode=disable'
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First-admin bootstrap: used only when the users table is empty; ignored (with
# a warning) once any user exists. The initial password must be changed on
# first login; the server log keeps reminding until it is.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-me-min-8-chars
