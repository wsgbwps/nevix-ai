# Local development only. Copy this file to .env.local before starting Server.
# make server-mailpit ignores this password placeholder and provisions an
# ephemeral identity_app credential for its Server process.
DATABASE_URL='postgresql://identity_app:replace-for-non-mailpit-startup@127.0.0.1:54322/postgres?sslmode=disable'
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Never reuse this development-only hash key outside the local environment.
VERIFICATION_CODE_HASH_KEY=local-development-only-verification-hash-key

# Mailpit captures mail locally; these credentials only satisfy Server config.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
SMTP_FROM=identity@nevix.test

# Optional: compress the production retry schedule (1m,5m,15m,1h,6h) locally.
OUTBOX_RETRY_DELAYS=1s,2s,3s,4s,5s
