# Nevix official public deployment configuration.
# Copy to deploy/.env (permissions 600) and fill in every value before
# `docker compose up`. Never commit deploy/.env.
#
# NEVIX_PUBLIC_IP is the fixed public IP customers connect to; it becomes the
# certificate's IP SAN and pins the TLS identity (TOFU fingerprint handover —
# see deploy/README.md).

# --- Required ---

# The deployment's fixed public IPv4 or IPv6 address.
NEVIX_PUBLIC_IP=203.0.113.10

# PostgreSQL superuser password (used only inside the internal Docker network
# for migrations; generated randomly per deployment).
# CHARSET CONTRACT: both passwords are interpolated into PostgreSQL URLs, so
# use ONLY letters, digits, hyphen, and underscore (URL-safe, no / @ : # % ?
# or other reserved characters) — anything else corrupts the DSN and the
# stack refuses to start. Length >= 24 recommended.
POSTGRES_PASSWORD=change-me-postgres-superuser

# Password for the identity_app runtime role; provisioned on the first boot
# of the pgdata volume and adopted unchanged afterwards (rotate via ALTER
# ROLE, see README). Same charset contract as POSTGRES_PASSWORD above.
NEVIX_IDENTITY_APP_PASSWORD=change-me-identity-app

# --- Optional ---

# Instance Claim protection. The public baseline forces the one-time setup
# code: complete the claim via the Desktop wizard BEFORE distributing the
# server URL. Keep true on any public IP; only a genuinely isolated intranet
# deployment should switch this to false explicitly after confirming no
# untrusted network path exists.
NEVIX_SETUP_CODE_REQUIRED=true

# Response whitelist echoed to browser-like clients; the Desktop is not a web
# page (its renderer origin is opaque and sends "null"), so the default is a
# placeholder. Set an explicit origin only if you add a browser client.
CORS_ALLOWED_ORIGINS=null

# Explicit certificate rotation switch — leave false. Rotation procedure:
# docker compose run --rm -e CERT_FORCE_NEW=true cert-init && docker compose
# restart nginx  (see deploy/README.md).
CERT_FORCE_NEW=false

# --- AI Creation reference-material storage (#156) ---
# filesystem(默认,挂载 blobs 卷)或 s3(S3-compatible 对象存储)
STORAGE_BACKEND=filesystem
# 仅 s3 生效（ADR-0013 部署级存储 seam）
#S3_ENDPOINT=
#S3_REGION=us-east-1
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_SECURE=true
